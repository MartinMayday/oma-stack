{
  "tagOwners": {
    "tag:oma-server": ["autogroup:admin"]
  },

  "grants": [
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "ip": ["*"]
    },
    {
      "src": ["autogroup:member"],
      "dst": ["tag:oma-server"],
      "ip": ["tcp:443", "tcp:9443", "tcp:2222", "tcp:22"]
    }
  ],

  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["root", "autogroup:nonroot"]
    },
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["tag:oma-server"],
      "users": ["root", "autogroup:nonroot"]
    }
  ]
}
