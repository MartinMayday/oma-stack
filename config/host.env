# host.env — THE ONE FILE YOU EDIT.
#
# Every script in oma-stack sources this file. Change a value here, re-run
# the installer, and the change is applied.
#
#   nano /etc/oma-stack/host.env      (installed copy)
#   ./install.sh                      (installed copy)
#
# Nothing here is a secret except the two "password" fields, and those are
# better left empty: the installer generates them and prints them once.
# Secrets that are not printed (tokens) are written to $CRED_DIR, mode 0600.

# ---------------------------------------------------------------------------
# 1. Identity
# ---------------------------------------------------------------------------
GITHUB_OWNER="MartinMayday"
GITHUB_USER="MartinMayday"

FORGEJO_USER="ci-admin"
FORGEJO_PASSWORD=""            # leave empty -> generated by the installer

# How the MacBook is reached. Use your tailnet name (e.g. macbook.tail1234.ts.net)
# or a real domain. "localhost" keeps the name local; EXPOSE_MODE decides
# what can reach it.
FORGEJO_DOMAIN="localhost"

# The URL the browser uses. install/40-exposure.sh rewrites ROOT_URL when you
# switch exposure mode, and the tailnet component rewrites it again with the
# tailnet name once the node is logged in.
FORGEJO_URL_FOR_DISPLAY="http://localhost:3000"

# The address Forgejo listens on.  Loopback keeps it off the LAN; the
# tailnet reaches it through tailscale serve, which proxies to 127.0.0.1.
# EXPOSE_MODE=lan overrides this to 0.0.0.0.
FORGEJO_BIND="127.0.0.1"

# The port Forgejo listens on.  Everything else (the mirror, the healthcheck,
# the tailnet publishing) reads it from here.
FORGEJO_PORT="3000"

# ---------------------------------------------------------------------------
# 2. Repositories to mirror GitHub -> Forgejo (space separated "owner/repo")
# ---------------------------------------------------------------------------
MIRROR_REPOS="MartinMayday/agent-library MartinMayday/agents-md-generator"

# Where the issue snapshot is published inside Forgejo
ISSUE_SNAPSHOT_REPO="issue-snapshot"

# ---------------------------------------------------------------------------
# 3. Storage layout
# ---------------------------------------------------------------------------
# INTERNAL 128 GB PCIe SSD — everything hot. Fastest and most durable thing
# in the box, and the whole working set is small (agent-library is 12 MB).
#   Forgejo SQLite DB, git repositories, Actions logs + artifacts,
#   the mirror's git cache, Docker data-root, runner work.
BOOT_DATA="/var/lib/forgejo"
REPO_ROOT="${BOOT_DATA}/forgejo-repositories"
ACTIONS_LOG="${BOOT_DATA}/actions-log"
ACTIONS_ARTIFACTS="${BOOT_DATA}/actions-artifacts"
MIRROR_CACHE="${BOOT_DATA}/mirror-cache"
DOCKER_DATA_ROOT="/var/lib/docker"

# 4 TB USB SATA — bulk and backups only. Nothing Forgejo needs in order to
# run, so an unmounted USB disk is never fatal.
USB_DISK="/mnt/usb"
BACKUP_ROOT="${USB_DISK}/backups"
BACKUP_RETENTION="7"           # number of dated snapshots to keep

# Set to 1 to put Actions logs + artifacts on the USB disk instead of the SSD.
# Off by default: it makes the USB disk a hard dependency of CI runs that
# produce artifacts, and the internal SSD has room for the retention window.
USB_HOLDS_ACTIONS="0"

# 512 GB SD card — OPTIONAL scratch for the runner. Auto-detected. When the
# card is not inserted the runner falls back to the internal SSD.
SCRATCH_DISK="/mnt/sd"
SCRATCH_WORK="${SCRATCH_DISK}/act-work"

# ---------------------------------------------------------------------------
# 4. Runner
# ---------------------------------------------------------------------------
RUNNER_USER="runner"
RUNNER_CAPACITY="1"            # 2 cores / 8 GB -> keep at 1

# Labels the Forgejo runner advertises.
# "self-hosted:host"  = run jobs directly on the host, no container (lowest RAM)
# "linux" / "x64"     = lets GitHub-style `runs-on: [self-hosted,linux,x64]` match
RUNNER_LABELS="self-hosted:host linux x64"

# Set to 1 to ALSO advertise an ubuntu-latest docker label.
# Needs ~2 GB RAM and a ~1 GB image pull. Off by default on this hardware.
ENABLE_DOCKER_LABEL="0"
DOCKER_LABEL="ubuntu-latest:docker://ghcr.io/catthehacker/ubuntu:act-22.04"

# ---------------------------------------------------------------------------
# 5. GitHub self-hosted runner
# ---------------------------------------------------------------------------
# 0 = skip. 1 = register the MacBook as a GitHub self-hosted runner for ALL
# repos owned by GITHUB_USER. This is the piece that keeps GitHub CI alive
# for PUBLIC repos even while the account is billing-locked.
ENABLE_GITHUB_RUNNER="1"
GITHUB_RUNNER_DIR="/opt/actions-runner"
GITHUB_RUNNER_NAME="macbook-forge"
GITHUB_RUNNER_LABELS="macbook,self-hosted,linux,x64"

# ---------------------------------------------------------------------------
# 6. Exposure
# ---------------------------------------------------------------------------
# How Forgejo is reachable.  The bind follows from the mode, and the default
# is the one that keeps the box off the LAN and off the internet.
#
#   tailnet = 127.0.0.1 only, published at https://<host>.<tailnet>.ts.net/
#             by the tailnet component (components/tailscale).  This is the
#             default: nothing on the LAN, nothing on the internet.
#   none    = 127.0.0.1 only and nothing publishes it.  This box only.
#   lan     = 0.0.0.0, reachable at http://<lan-ip>:3000/ from the LAN.
#             Explicit opt-in: every device on the network can reach it.
#   caddy   = public https on your own domain (needs DNS + ports 80/443).
#
# `tailscale` is accepted as a legacy spelling of `tailnet`.
EXPOSE_MODE="tailnet"

# Only used when EXPOSE_MODE=caddy
FORGEJO_DOMAIN_CADDY=""       # e.g. git.example.com
FORGEJO_ACME_EMAIL=""         # e.g. you@example.com

# ---------------------------------------------------------------------------
# 7. Always-on behaviour
# ---------------------------------------------------------------------------
ENABLE_ALWAYS_ON="1"           # ignore lid switch, block suspend
DOCKER_MEMORY_LIMIT="4g"      # leave the other 4 GB to the desktop

# ---------------------------------------------------------------------------
# 8. Tokens (never commit these; they live in $CRED_DIR, mode 0600)
# ---------------------------------------------------------------------------
CRED_DIR="/etc/oma-stack"
GITHUB_TOKEN_FILE="${CRED_DIR}/github.token"
FORGEJO_TOKEN_FILE="${CRED_DIR}/forgejo.token"

# ---------------------------------------------------------------------------
# 9. Schedules
# ---------------------------------------------------------------------------
MIRROR_INTERVAL_MIN="15"
ISSUE_SNAPSHOT_INTERVAL_MIN="30"
HEALTHCHECK_INTERVAL_MIN="10"
BACKUP_INTERVAL_H="6"          # how often to snapshot to the USB disk

# ---------------------------------------------------------------------------
# 10. OpenBot  (CopilotKit/OpenBot — the agent surface)
# ---------------------------------------------------------------------------
# 0 = do not install OpenBot. 1 = install and run it in Docker.
ENABLE_OPENBOT="1"

# The published image. One image carries the app, the API, the browser the
# Bots drive and (optionally) PostgreSQL. Pin a tag for a reproducible box:
# "latest" moves under your feet.
OPENBOT_IMAGE="ghcr.io/copilotkit/openbot:v1.0.2"

# Host port. The image serves the app and the API on the same origin.
OPENBOT_PORT="3001"

# Which address the port is published on. 127.0.0.1 keeps it on this
# machine, which is the right posture while OPENBOT_SINGLE_USER is on:
# in single-user mode anyone who can reach the port is an administrator.
OPENBOT_BIND="127.0.0.1"

# Where the image's data lives. The embedded database is the only thing that
# must survive a reboot.
OPENBOT_DATA_DIR="${BOOT_DATA}/openbot"
OPENBOT_VOLUME="oma-openbot-data"

# The Bot workspaces and the signed-in browser profiles. Both live in named
# volumes: without them every redeploy deletes the work and logs the Bots
# out of every site they are signed into.
OPENBOT_WORKSPACE_VOLUME="oma-openbot-workspace"
OPENBOT_PROFILES_VOLUME="oma-openbot-profiles"

# How long a Bot's stream may stay silent before OpenBot gives up on the
# turn, in milliseconds. The upstream default is 60000, which is shorter than
# the latency of a real agent; the bridge also sends a heartbeat.
OPENBOT_STALL_TIMEOUT_MS="300000"

# The image ships no scheduler, so the routines sweep and the staged
# attachment sweep would never run. 1 = run them hourly.
OPENBOT_WORKER_TIMER="1"

# Single operator mode: every request is admitted as one administrator.
# Correct on a laptop. Turn it off the moment a second person can reach it.
OPENBOT_SINGLE_USER="true"

# --- the three secrets OpenBot refuses to start without --------------------
# Generated by the installer into $CRED_DIR/openbot.env if left empty.
OPENBOT_KEY_ENCRYPTION_KEY=""     # openssl rand -base64 32
OPENBOT_COMPUTER_TOKEN=""         # the computer's request control
OPENBOT_SUPERVISOR_TOKEN=""       # the supervisor's shared secret
OPENBOT_AGENT_TOOL_TOKEN=""       # what a Bot presents to call a tool back
OPENBOT_WORKER_SHARED_SECRET=""   # what the routine worker presents
OPENBOT_MANAGED_AGENT_TOKEN=""    # what the server sends to a managed Bot

# --- Intelligence ----------------------------------------------------------
# OpenBot will not start without these three. Two ways to get them:
#
#   A) managed CopilotKit Intelligence (default endpoints below)
#        npx --yes copilotkit@latest login
#        npx --yes copilotkit@latest project select
#      then copy the three values the CLI prints into
#      ${CRED_DIR}/openbot.env
#
#   B) local Intelligence on this machine (free Developer plan)
#        npx --yes copilotkit@latest local connect
#      run from a directory that holds a .env — it writes the three values
#      for you.
#
# Leave OPENBOT_INTELLIGENCE_API_KEY empty and the installer copies whatever
# is already in ${CRED_DIR}/openbot.env without overwriting it.
OPENBOT_INTELLIGENCE_API_URL="https://api.intelligence.copilotkit.ai"
OPENBOT_INTELLIGENCE_GATEWAY_WS_URL="wss://realtime.intelligence.copilotkit.ai"
OPENBOT_INTELLIGENCE_API_KEY=""

# --- the model -------------------------------------------------------------
# The model key the Bots spend. OpenAI, Anthropic or Google — pick one.
# The key itself goes in ${CRED_DIR}/openbot.env, never in this file.
OPENBOT_MODEL_PROVIDER="openai"          # openai | anthropic | google
OPENBOT_MODEL=""                         # blank = the provider's default

# --- the agent bridge ------------------------------------------------------
# Private addresses an agent may be registered at.  The format is host or
# host:port, comma separated, with no scheme, no path and no wildcards — a
# URL or a "*" here stops OpenBot from starting.
#
# This list permits private addresses; it does not restrict which agents may
# be registered at a public address.  The match is exact against the
# hostname of the registered URL, so the URL has to use one of these names:
#
#   http://host.docker.internal:8765/ag-ui/qoder
#
# The installer adds the bridge host and the Docker gateway address.
OPENBOT_AGENT_ENDPOINT_ALLOWED_HOSTS=""

# ---------------------------------------------------------------------------
# 11. Agent bridge  (OpenBot -> your local agents, over AG-UI)
# ---------------------------------------------------------------------------
# 0 = do not run the bridge. 1 = run it as a systemd service.
ENABLE_AGENT_BRIDGE="1"

# The bridge speaks AG-UI so OpenBot can call a local agent the way it calls
# any other. It listens here and is reached from the OpenBot container.
AGENT_BRIDGE_PORT="8765"
AGENT_BRIDGE_BIND="0.0.0.0"     # the OpenBot container reaches the host, not loopback

# Who may call the bridge. The peer address of every request is checked
# against this list — forwarded headers are never trusted.
#   127.0.0.1/32    your own tools
#   ::1/128        the same over IPv6
#   172.16.0.0/12  docker networks (the OpenBot container)
#   100.64.0.0/10  the tailnet (only if you serve the bridge over it)
# The LAN is NOT in the list, so a device on the wifi cannot run your agents.
AGENT_BRIDGE_ALLOWED_IPS="127.0.0.1/32,::1/128,172.16.0.0/12,100.64.0.0/10"

# How often the bridge says something while an agent is working, in seconds.
# OpenBot ends a turn when the stream goes quiet, and a CLI agent is silent
# for the whole model latency. 0 turns the heartbeat off.
AGENT_BRIDGE_HEARTBEAT_SECONDS="15"

# Who runs the bridge. Empty = the account that ran the installer (the
# operator), which is where the agents' own sessions and credentials live.
AGENT_BRIDGE_USER=""

# The agent registry. Each entry becomes one AG-UI endpoint OpenBot can
# register. "command" is what runs the agent; the bridge streams its stdout
# back as the assistant's answer.
AGENT_BRIDGE_REGISTRY="${CRED_DIR}/agents.json"

# The default agent — the one OpenBot uses when nothing else is chosen.
# "auto" means the first agent in the chain that can actually run on this
# box.  Name one explicitly to pin it.
AGENT_DEFAULT="auto"

# Where case files live (the agent-library work-item boxes). The bridge
# watches this tree for the handoff queue.
HANDOFF_ROOT="/var/lib/oma-stack/handoff"
HANDOFF_WATCH_DIR="${HANDOFF_ROOT}/inbox"

# ---------------------------------------------------------------------------
# 12. Tooling
# ---------------------------------------------------------------------------
# 0 = skip. 1 = install the small CLI helpers the agents expect.
ENABLE_TOOLING="1"

# Where the Hermes persona library is installed (the agent-library catalog).
HERMES_PERSONA_SOURCE=""

# Python tooling installed with pip (user scope, never system).
PIP_PACKAGES="agent-library fleet-registry"

# ---------------------------------------------------------------------------
# 13. Tailnet (Tailscale) — private access from your own devices
# ---------------------------------------------------------------------------
# 0 = skip. 1 = install tailscale and publish the stack on the tailnet.
#
# Nothing is exposed to the public internet.  The services keep their
# loopback binds and tailscaled proxies the tailnet HTTPS endpoint to them.
# This is `tailscale serve`, never `tailscale funnel`.
ENABLE_TAILSCALE="1"

# The name this box answers to on the tailnet.  Keep it short — it becomes
# oma.<tailnet>.ts.net in every URL.
TAILSCALE_HOSTNAME="oma"

# 1 = let tailscale answer DNS for the whole tailnet (right for a server,
#     and what makes oma.<tailnet>.ts.net resolve on this box)
# 0 = keep this machine's own resolver, which leaves the MagicDNS names
#     unresolvable system-wide (check with: tailscale dns query <name>)
TAILSCALE_ACCEPT_DNS="1"

# 1 = enable Tailscale SSH.  Off by default: the box already has real SSH.
TAILSCALE_SSH="0"

# Tags this node claims.  A tagged node does not expire its key every 180
# days, so the box stays reachable without a monthly re-auth.  The tag has to
# exist in the tailnet policy first, and it cannot be combined with a
# pre-auth key: an auth key carries its own tags.
TAILSCALE_TAGS="tag:oma-server"

# A pre-auth key logs a headless machine in without a browser.  Leave it
# empty and the installer prints a login URL instead.
TAILSCALE_AUTHKEY=""

# Which services are published on the tailnet, and on which HTTPS port.
TAILSCALE_SERVE_FORGEJO="1"
TAILSCALE_SERVE_BRIDGE="1"
TAILSCALE_SERVE_HTTPS_PORT="443"
TAILSCALE_SERVE_BRIDGE_PORT="9443"

# OpenBot is published differently: on the tailnet ADDRESS, in plain HTTP,
# rather than through tailscale serve.  OpenBot in single-user mode refuses
# to start when it is given a public address, and a MagicDNS name is public
# to it while a 100.x tailnet address is private.  The tailnet transport is
# encrypted anyway.
TAILSCALE_PUBLISH_OPENBOT="1"
